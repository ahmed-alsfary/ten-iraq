APP_NAME=TenderIQ Iraq
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Local (no Docker): persistent SQLite under backend/data/
DATABASE_URL=sqlite:///./data/tenderiq.db

# With Docker / PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://tenderiq:tenderiq@localhost:5432/tenderiq

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tenderiq
MINIO_SECRET_KEY=tenderiqsecret
MINIO_BUCKET=tenderiq
MINIO_SECURE=false

CORS_ORIGINS=http://localhost:8000

# Auto-crawl all sources (local in-process scheduler)
CRAWL_SCHEDULER_ENABLED=true
CRAWL_INTERVAL_MINUTES=60
CRAWL_SCHEDULER_INITIAL_DELAY_SECONDS=45
